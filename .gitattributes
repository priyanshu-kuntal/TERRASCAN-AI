# Auto-detect text files and perform LF normalization on checkout
* text=auto

# Python, HTML, CSS, JavaScript, Markdown files
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary media files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pt binary
*.pth binary
